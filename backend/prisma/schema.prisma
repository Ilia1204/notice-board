generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
}

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String      @map("password_hash")
  name         String
  role         Role        @default(USER)
  createdAt    DateTime    @default(now()) @map("created_at")
  ads          Ad[]
  favorites    Favorite[]
  chats        Chat[]
  messages     Message[]
  // Жалобы, которые подал пользователь, и жалобы на него самого (Т13)
  complaints   Complaint[] @relation("ComplaintReporter")
  reportedIn   Complaint[] @relation("ComplaintTarget")

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  ads         Ad[]

  @@map("categories")
}

// Новое объявление ждёт проверки модератором (Т6)
enum AdStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Ad {
  id          Int         @id @default(autoincrement())
  title       String
  description String
  // Цена в рублях; null — «договорная»
  price       Int?
  // Категорию с объявлениями удалить нельзя
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId  Int         @map("category_id")
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId    Int         @map("author_id")
  status      AdStatus    @default(PENDING)
  images      AdImage[]
  favorites   Favorite[]
  chats       Chat[]
  complaints  Complaint[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([authorId])
  @@map("ads")
}

model AdImage {
  id       Int    @id @default(autoincrement())
  // Имя файла в папке загрузок (UPLOAD_DIR)
  filename String @unique
  position Int
  ad       Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId     Int    @map("ad_id")

  @@index([adId])
  @@map("ad_images")
}

// Избранное пользователя (Т8): одно объявление можно добавить только один раз
model Favorite {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  ad        Ad       @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      Int      @map("ad_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, adId])
  @@index([adId])
  @@map("favorites")
}

// Диалог покупателя с автором объявления (Т10): по одному объявлению — один диалог
model Chat {
  id        Int       @id @default(autoincrement())
  ad        Ad        @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId      Int       @map("ad_id")
  buyer     User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId   Int       @map("buyer_id")
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  // Время последнего сообщения: по нему сортируем список диалогов
  updatedAt DateTime  @default(now()) @map("updated_at")

  @@unique([adId, buyerId])
  @@index([buyerId])
  @@map("chats")
}

model Message {
  id        Int       @id @default(autoincrement())
  chat      Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  chatId    Int       @map("chat_id")
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId  Int       @map("sender_id")
  text      String
  createdAt DateTime  @default(now()) @map("created_at")
  // Когда получатель открыл диалог (Т12); null — сообщение ещё не прочитано
  readAt    DateTime? @map("read_at")

  @@index([chatId, createdAt])
  @@map("messages")
}

enum ComplaintReason {
  SPAM
  FRAUD
  PROHIBITED
  OFFENSIVE
  OTHER
}

// Принятая жалоба скрывает объявление или все объявления пользователя
enum ComplaintStatus {
  OPEN
  ACCEPTED
  DISMISSED
}

// Жалоба (Т13): на объявление или на пользователя — заполнено ровно одно из adId и userId
model Complaint {
  id         Int             @id @default(autoincrement())
  reporter   User            @relation("ComplaintReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId Int             @map("reporter_id")
  ad         Ad?             @relation(fields: [adId], references: [id], onDelete: Cascade)
  adId       Int?            @map("ad_id")
  user       User?           @relation("ComplaintTarget", fields: [userId], references: [id], onDelete: Cascade)
  userId     Int?            @map("user_id")
  reason     ComplaintReason
  comment    String?
  status     ComplaintStatus @default(OPEN)
  createdAt  DateTime        @default(now()) @map("created_at")
  resolvedAt DateTime?       @map("resolved_at")

  @@index([status, createdAt])
  @@index([adId])
  @@index([userId])
  @@map("complaints")
}
